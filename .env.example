# Copy to .env and add your API key. Never commit the real .env.
#
# The defaults target DeepSeek. Set all three values explicitly so the active
# provider, endpoint, and model are visible in one place.
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
#
# Use deepseek-v4-pro for the stronger model:
# LLM_MODEL=deepseek-v4-pro
#
# DeepSeek thinking mode is enabled by default (effort high). Set at most one
# of these to control it:
# LLM_THINKING=disabled          # enabled | disabled
# LLM_REASONING_EFFORT=high      # none | low | high | max
#
# Other OpenAI-compatible providers: change both LLM_MODEL and LLM_BASE_URL.
# OpenAI example:
# LLM_MODEL=<your-model-id>
# LLM_BASE_URL=https://api.openai.com/v1
#
# OpenRouter example:
# LLM_MODEL=<vendor/model-id>
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Keyless local server example (Ollama, vLLM, LM Studio):
# LLM_API_KEY=local
# LLM_MODEL=<your-model-id>
# LLM_BASE_URL=http://localhost:11434/v1
